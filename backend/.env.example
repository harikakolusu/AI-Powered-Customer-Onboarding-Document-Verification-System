# ──────────────────────────────────────────────
# Backend Environment Configuration — EXAMPLE
# Copy this file to backend/.env and fill in values
# ──────────────────────────────────────────────

# Database URL (SQLite by default — relative to project root)
DATABASE_URL=sqlite:///storage/onboarding.db

# LLM Configuration — Google Gemini API
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-1.5-flash

# Image Quality Thresholds
BLUR_THRESHOLD=100.0

